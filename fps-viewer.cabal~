cabal-version:      2.4
name:               fps-viewer
version:            0.1.0.0
build-type:         Simple

executable fps-viewer
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Parquet.Util
                      Parquet.Snappy
                      Parquet.Thrift
                      Parquet.Reader
                      Types
                      Library
    default-language: Haskell2010
    ghc-options:      -Wall -threaded -rtsopts
    build-depends:    base >=4.14 && <5
                    , bytestring
                    , text
                    , containers
                    , directory
                    , filepath
                    , aeson
                    , yesod-core
